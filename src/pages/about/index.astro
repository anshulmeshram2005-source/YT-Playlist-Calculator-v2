---
// /about/ — About page
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="About YT Playlist Cal — Free YouTube Playlist Calculator"
  description="Learn about YT Playlist Cal — a free, fast, privacy-conscious YouTube playlist length and watch time calculator. Independent and user-focused."
  pageKey="about"
>
  <Header />
  <main class="py-12 sm:py-16">
    <div class="container content-width">

      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-1.5 text-xs" style="color: var(--color-text-muted);">
          <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;" data-i18n="nav.home">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" style="color: var(--color-text);" data-i18n="pages.about.breadcrumb">About</li>
        </ol>
      </nav>

      <h1 class="text-3xl font-bold tracking-tight mb-3" style="color: var(--color-text); letter-spacing: -0.03em;" data-i18n="pages.about.title">
        About YT Playlist Cal
      </h1>
      <p class="text-base leading-relaxed mb-8" style="color: var(--color-text-muted);" data-i18n="pages.about.subtitle">
        YT Playlist Cal is a free, fast, and privacy-conscious tool for calculating the total duration of any public YouTube playlist.
      </p>

      <div class="space-y-8 text-sm leading-relaxed" style="color: var(--color-text-muted);">

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);" data-i18n="pages.about.whatWeDoTitle">What We Do</h2>
          <p data-i18n="pages.about.whatWeDoP1">
            YouTube doesn't show you the total length of a playlist. If you're a student planning to finish a programming course, someone binge-watching a series, or a teacher reviewing content — you often need to know the total time commitment upfront.
          </p>
          <p class="mt-3" data-i18n="pages.about.whatWeDoP2">
            YT Playlist Cal solves that problem: paste any YouTube playlist URL and instantly get the total duration, along with watch-time estimates at different playback speeds (1×, 1.5×, 2×, or custom), a per-video breakdown, and a daily watch planner.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);" data-i18n="pages.about.principlesTitle">Our Principles</h2>
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <span style="color: var(--color-accent);" aria-hidden="true">•</span>
              <span data-i18n="pages.about.p1"><strong style="color: var(--color-text);">Free, forever.</strong> No signup, no paywall, no mandatory account.</span>
            </li>
            <li class="flex items-start gap-2">
              <span style="color: var(--color-accent);" aria-hidden="true">•</span>
              <span data-i18n="pages.about.p2"><strong style="color: var(--color-text);">Privacy by design.</strong> We do not store your playlist URLs, track browsing history, or sell personal data.</span>
            </li>
            <li class="flex items-start gap-2">
              <span style="color: var(--color-accent);" aria-hidden="true">•</span>
              <span data-i18n="pages.about.p3"><strong style="color: var(--color-text);">Fast and accurate.</strong> Server-side API fetching with edge acceleration.</span>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);" data-i18n="pages.about.trademarkTitle">Independence & Trademarks</h2>
          <p data-i18n="pages.about.trademarkP">
            YT Playlist Cal is an independent utility. YouTube™ is a trademark of Google LLC. We are not endorsed by, sponsored by, or affiliated with YouTube or Google LLC.
          </p>
        </section>

        <div class="pt-6" style="border-top: 1px solid var(--color-border);">
          <a
            href="/contact/"
            class="text-sm font-medium"
            style="color: var(--color-text);"
            data-i18n="footer.links.contact"
          >
            Contact us →
          </a>
        </div>

      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
